pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Installing dependencies...'
                sh '''
                    cd Assignment9/python-flask-app
                    python3 -m pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '''
                    cd Assignment9/python-flask-app
                    python3 -m unittest discover -s .
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    rm -rf ${WORKSPACE}/python-app-deploy
                    mkdir -p ${WORKSPACE}/python-app-deploy

                    cp Assignment9/python-flask-app/app.py \
                       ${WORKSPACE}/python-app-deploy/

                    cp Assignment9/python-flask-app/requirements.txt \
                       ${WORKSPACE}/python-app-deploy/
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Running application...'
                sh '''
                    nohup python3 ${WORKSPACE}/python-app-deploy/app.py \
                    > ${WORKSPACE}/python-app-deploy/app.log 2>&1 &

                    echo $! > ${WORKSPACE}/python-app-deploy/app.pid

                    sleep 3
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing deployed application...'
                sh '''
                    python3 - <<'PY'
                    import urllib.request

                    url = "http://127.0.0.1:5000/"
                    response = urllib.request.urlopen(url)

                    body = response.read().decode()

                    print("HTTP Status:", response.status)
                    print("Response:", body)

                    assert response.status == 200
                    assert body == "Hello, Jenkins Multi-Stage Pipeline!"
                    PY
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
